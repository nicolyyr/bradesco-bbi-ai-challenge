# ---------------------------------------------------------------------------
# Bradesco BBI AI Challenge — environment configuration
#
# Copy this file to ".env" and fill in your values:
#     cp .env.example .env
#
# The app works with NO configuration at all: with no OPENAI_API_KEY it runs in
# deterministic MOCK mode so the demo is reproducible without credentials.
# To exercise the REAL generative-AI path, set OPENAI_API_KEY below.
# ---------------------------------------------------------------------------

# --- Provider selection -----------------------------------------------------
# "gemini" (default real provider, has a free tier) | "openai" | "mock".
# If left empty, the app auto-selects in this order:
#   GEMINI_API_KEY present -> gemini
#   else OPENAI_API_KEY present -> openai
#   else -> mock (deterministic, no credentials)
LLM_PROVIDER=

# --- Google Gemini (default real mode) --------------------------------------
# Get a free key at https://aistudio.google.com/apikey
# NEVER commit a real key. Leave blank to fall back to OpenAI or mock.
# (GOOGLE_API_KEY is also accepted - it's what the SDK reads by default.)
GEMINI_API_KEY=
# Model to use (JSON mode via response_mime_type). Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (alternative real mode) -----------------------------------------
# Your API key. NEVER commit a real key. Leave blank to force gemini/mock.
OPENAI_API_KEY=
# Model to use (chat.completions with JSON mode). Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Optional: custom base URL for OpenAI-compatible gateways (Azure, proxies...).
OPENAI_BASE_URL=

# --- Generation tunables ----------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_MAX_RETRIES=2

# --- Resilience -------------------------------------------------------------
# If true, an LLM/parse/validation failure falls back to the deterministic
# baseline instead of raising. Recommended true for live demos.
LLM_ALLOW_FALLBACK=true

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LLM_LOG_LEVEL=INFO
