# ---------------------------------------------------------------------------
# Bradesco BBI AI Challenge — environment configuration
#
# Copy this file to ".env" and fill in your values:
#     cp .env.example .env
#
# The app works with NO configuration at all: with no OPENAI_API_KEY it runs in
# deterministic MOCK mode so the demo is reproducible without credentials.
# To exercise the REAL generative-AI path, set OPENAI_API_KEY below.
# ---------------------------------------------------------------------------

# --- Provider selection -----------------------------------------------------
# "openai" = real LLM (requires OPENAI_API_KEY). "mock" = deterministic, offline.
# If left empty, the app auto-selects: openai when a key is present, else mock.
LLM_PROVIDER=

# --- OpenAI (real mode) -----------------------------------------------------
# Your API key. NEVER commit a real key. Leave blank to force mock mode.
OPENAI_API_KEY=
# Model to use (chat.completions with JSON mode). Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Optional: custom base URL for OpenAI-compatible gateways (Azure, proxies...).
OPENAI_BASE_URL=

# --- Generation tunables ----------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_MAX_RETRIES=2

# --- Resilience -------------------------------------------------------------
# If true, an LLM/parse/validation failure falls back to the deterministic
# baseline instead of raising. Recommended true for live demos.
LLM_ALLOW_FALLBACK=true

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LLM_LOG_LEVEL=INFO
