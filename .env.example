# ---------------------------------------------------------------------------
# Bradesco BBI AI Challenge — environment configuration
#
# Copy this file to ".env" and fill in your key:
#     cp .env.example .env
#
# Generative AI is MANDATORY: this solution has no offline/mock mode. Set a
# Gemini key (free tier) or an OpenAI key before running.
# ---------------------------------------------------------------------------

# --- Provider selection -----------------------------------------------------
# "gemini" (default, has a free tier) | "openai".
# If left empty, the app auto-selects:
#   GEMINI_API_KEY present -> gemini
#   else OPENAI_API_KEY present -> openai
#   else -> error (a key is required)
LLM_PROVIDER=

# --- Google Gemini (default provider) ---------------------------------------
# Get a FREE key at https://aistudio.google.com/apikey
# NEVER commit a real key (.env is git-ignored).
# (GOOGLE_API_KEY is also accepted - it's what the SDK reads by default.)
GEMINI_API_KEY=
# Model (JSON mode via response_mime_type + native response_schema).
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (alternative provider) ------------------------------------------
# Your API key. NEVER commit a real key. Leave blank to use Gemini.
OPENAI_API_KEY=
# Model (chat.completions with JSON mode). Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Optional: custom base URL for OpenAI-compatible gateways (Azure, proxies...).
OPENAI_BASE_URL=

# --- Generation tunables ----------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8000
LLM_MAX_RETRIES=4

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LLM_LOG_LEVEL=INFO
